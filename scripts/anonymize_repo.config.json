  ],

  "renames": [
    { "old_path": "img/wildIntel_logo.webp", "new_path": "img/project_logo.webp" },
    { "old_path": "docs/img/wildIntel_logo.webp", "new_path": "docs/img/project_logo.webp" },
    { "old_path": "docs/img/WildINTEL_onlyCircle_25.png", "new_path": "docs/img/project_icon.png" },
    { "old_path": "backend/docs/img/WildINTEL_onlyCircle_25.png", "new_path": "backend/docs/img/project_icon.png" }
  ],

  "skip_extensions": [
    ".png", ".webp", ".jpg", ".jpeg", ".gif", ".ico", ".svg", ".pdf",
    ".woff", ".woff2", ".ttf", ".eot", ".otf",
    ".zip", ".gz", ".tar", ".7z",
    ".pyc", ".so", ".dylib", ".dll", ".exe"
  ],

  "report_patterns": [
    "wildintelproject",
    "(?i)wildintel",
    "[\\w.+-]+@[\\w-]+\\.[a-zA-Z]{2,}",
    "\\bGA No\\.",
    "\\bPCI20\\d\\d-",
    "\\bUMO-",
    "\\bNFR\\d+",
    "/home/(?!user/)[a-zA-Z0-9_.-]+/",
    "C:\\\\Users\\\\[a-zA-Z0-9_.-]+"
  ]
}
